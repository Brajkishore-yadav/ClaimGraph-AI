# ============================================================
# ClaimGraph AI — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claimgraph
POSTGRES_USER=claimgraph_user
POSTGRES_PASSWORD=changeme_postgres_password

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j_password

# --- API Security ---
API_KEY=changeme_api_key_at_least_32_chars_long

# --- LLM (pick one, comment out the other) ---
# Option 1: Google Gemini (free tier available)
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
